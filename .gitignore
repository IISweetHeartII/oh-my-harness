# Modified from revfactory/harness (Apache-2.0, Copyright 2025 robin):
# un-ignore the test fixture's .claude/ directory.
.DS_Store
.claude/
_workspace/

# The linter's reference harness lives under a .claude/ directory by necessity —
# that is the shape it has to have. The blanket ignore above swallowed it whole,
# and CI ran against a repository where the fixture did not exist while it sat
# on disk locally. Git cannot re-include a file whose parent directory is
# excluded, so the directory itself has to be un-excluded first.
!tests/fixtures/**/.claude/
!tests/fixtures/**/.claude/**

# byte-compiled python — generated, and version-specific
__pycache__/
*.pyc

# 에이전트 런타임 스크래치 — 레포 내용이 아니다.
# 🔴 .git/info/exclude 에만 적으면 «내 기계에서만» 제외된다. 신선 클론과
#    가드레일 복사본에서는 그대로 스캔에 들어온다(실측).
.omc/
.omx/
